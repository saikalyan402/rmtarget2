    buckets = pd.cut(
        achievement,
        bins=achievement_bins,
        labels=achievement_labels,
    )

    achievement_distribution = (
        buckets
        .value_counts()
        .sort_index()
        .reset_index()
    )

    achievement_distribution.columns = [
        "Achievement Range",
        "RM Count",
    ]

    fig = px.bar(
        achievement_distribution,
        x="Achievement Range",
        y="RM Count",
        text="RM Count",
        title="Projected RM Achievement Distribution",
    )

    fig.update_traces(
        textposition="outside",
    )

    fig.update_layout(
        template="plotly_white",
        height=450,
    )

    st.plotly_chart(
        fig,
        use_container_width=True,
    )

    # ========================================================
    # TARGET VS ACHIEVEMENT
    # ========================================================
    st.subheader(
        "Target vs Projected Net Sales"
    )

    fig = px.scatter(
        scenario_df,
        x="FY26 Target",
        y="Projected Final NS",
        size="Projected Final NS",
        hover_name=(
            "Employee Name"
            if "Employee Name" in scenario_df.columns
            else None
        ),
        title="FY26 Target vs Projected Final Net Sales",
    )

    # 100% achievement line
    max_value = max(
        scenario_df["FY26 Target"].max(),
        scenario_df["Projected Final NS"].max(),
    )

    fig.add_trace(
        go.Scatter(
            x=[0, max_value],
            y=[0, max_value],
            mode="lines",
            name="100% Target",
        )
    )

    fig.update_layout(
        template="plotly_white",
        height=550,
    )

    st.plotly_chart(
        fig,
        use_container_width=True,
    )

    # ========================================================
    # REGION PERFORMANCE
    # ========================================================
    if "REGION" in scenario_df.columns:
        st.subheader(
            "Region-wise Performance"
        )

        region = (
            scenario_df
            .groupby("REGION", dropna=False)
            .agg(
                Target=("FY26 Target", "sum"),
                Current_Achievement=(
                    "Current Achievement",
                    "sum",
                ),
                Projected_NS=(
                    "Projected Final NS",
                    "sum",
                ),
                RM_Count=(
                    "FY26 Target",
                    "count",
                ),
            )
            .reset_index()
        )

        region["Achievement %"] = np.where(
            region["Target"] > 0,
            region["Projected_NS"]
            / region["Target"]
            * 100,
            0,
        )

        fig = px.bar(
            region.sort_values(
                "Projected_NS",
                ascending=False,
            ),
            x="REGION",
            y="Projected_NS",
            color="Achievement %",
            text="Achievement %",
            title="Projected Net Sales by Region",
        )

        fig.update_traces(
            texttemplate="%{text:.1f}%",
            textposition="outside",
        )

        fig.update_layout(
            template="plotly_white",
            height=500,
        )

        st.plotly_chart(
            fig,
            use_container_width=True,
        )

        st.dataframe(
            region.style.format(
                {
                    "Target": "₹{:,.2f}",
                    "Current_Achievement": "₹{:,.2f}",
                    "Projected_NS": "₹{:,.2f}",
                    "Achievement %": "{:.1f}%",
                    "RM_Count": "{:,.0f}",
                }
            ),
            use_container_width=True,
            hide_index=True,
        )

    # ========================================================
    # ZONE PERFORMANCE
    # ========================================================
    if "ZONE" in scenario_df.columns:
        st.subheader(
            "Zone-wise Performance"
        )

        zone = (
            scenario_df
            .groupby("ZONE", dropna=False)
            .agg(
                Target=("FY26 Target", "sum"),
                Projected_NS=(
                    "Projected Final NS",
                    "sum",
                ),
                RM_Count=(
                    "FY26 Target",
                    "count",
                ),
            )
            .reset_index()
        )

        zone["Achievement %"] = np.where(
            zone["Target"] > 0,
            zone["Projected_NS"]
            / zone["Target"]
            * 100,
            0,
        )

        st.dataframe(
            zone.style.format(
                {
                    "Target": "₹{:,.2f}",
                    "Projected_NS": "₹{:,.2f}",
                    "Achievement %": "{:.1f}%",
                    "RM_Count": "{:,.0f}",
                }
            ),
            use_container_width=True,
            hide_index=True,
        )

    # ========================================================
    # TOP / BOTTOM TABLE
    # ========================================================
    st.subheader(
        "Top and Bottom RMs"
    )

    if "Employee Name" in scenario_df.columns:
        cols = [
            "Employee Name",
            "FY26 Target",
            "Current Achievement",
            "Projected Final NS",
            "Projected Achievement %",
            "Revenue Contribution %",
        ]

        cols = [
            c
            for c in cols
            if c in scenario_df.columns
        ]

        top = scenario_df.nlargest(
            10,
            "Projected Achievement %",
        )[cols]

        bottom = scenario_df.nsmallest(
            10,
            "Projected Achievement %",
        )[cols]

        col1, col2 = st.columns(2)

        with col1:
            st.markdown("### 🏆 Top 10 RMs")

            st.dataframe(
                top.style.format(
                    {
                        "FY26 Target": "₹{:,.2f}",
                        "Current Achievement": "₹{:,.2f}",
                        "Projected Final NS": "₹{:,.2f}",
                        "Projected Achievement %": "{:.1f}%",
                        "Revenue Contribution %": "{:.2f}%",
                    }
                ),
                use_container_width=True,
                hide_index=True,
            )

        with col2:
            st.markdown("### ⚠️ Bottom 10 RMs")

            st.dataframe(
                bottom.style.format(
                    {
                        "FY26 Target": "₹{:,.2f}",
                        "Current Achievement": "₹{:,.2f}",
                        "Projected Final NS": "₹{:,.2f}",
                        "Projected Achievement %": "{:.1f}%",
                        "Revenue Contribution %": "{:.2f}%",
                    }
                ),
                use_container_width=True,
                hide_index=True,
            )


