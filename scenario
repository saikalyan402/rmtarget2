# ============================================================
# HELPERS
# ============================================================

def clean_column_name(col):
    """
    Normalize Excel column names.
    """
    col = str(col)

    replacements = {
        "\xa0": " ",
        "\n": " ",
        "\r": " ",
        "\t": " ",
    }

    for old, new in replacements.items():
        col = col.replace(old, new)

    col = " ".join(col.split())

    return col.strip()


def clean_dataframe(df):
    """
    Clean Excel dataframe.
    """
    df = df.copy()

    df.columns = [clean_column_name(c) for c in df.columns]

    # Remove completely empty rows
    df = df.dropna(how="all")

    # Remove completely empty columns
    df = df.dropna(axis=1, how="all")

    return df


def find_column(df, expected_name):
    """
    Find a column even if Excel contains
    slightly different spacing/case.
    """
    expected = clean_column_name(expected_name).lower()

    normalized = {
        clean_column_name(c).lower(): c
        for c in df.columns
    }

    if expected in normalized:
        return normalized[expected]

    # Partial matching
    for normalized_name, original_name in normalized.items():
        if expected in normalized_name:
            return original_name

    return None


def numeric_series(df, column):
    """
    Convert a dataframe column to numeric safely.
    """
    if column not in df.columns:
        return pd.Series(0, index=df.index)

    return pd.to_numeric(
        df[column]
        .astype(str)
        .str.replace(",", "", regex=False)
        .str.replace("%", "", regex=False)
        .replace(["NA", "N/A", "-", "", "nan", "None"], np.nan),
        errors="coerce",
    ).fillna(0)


def format_amount(value):
    """
    Format amounts in Cr.
    """
    value = float(value)

    if abs(value) >= 1000:
        return f"₹{value:,.0f} Cr"

    return f"₹{value:,.2f} Cr"


def format_percent(value):
    return f"{value:.1f}%"


