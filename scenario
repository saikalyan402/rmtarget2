def main():
    st.sidebar.title("RM Retail Sales")

    st.sidebar.markdown(
        """
### 📊 Scenario Dashboard

Upload the Excel workbook containing:

**RM Retail Sales**

The application will automatically
read only this sheet.
"""
    )

    uploaded_file = st.sidebar.file_uploader(
        "Upload Excel Workbook",
        type=[
            "xlsx",
            "xls",
            "xlsb",
        ],
    )

    if uploaded_file is None:
        st.title(
            "📊 RM Retail Sales Scenario Dashboard"
        )

        st.info(
            "Please upload the Excel workbook "
            "containing the 'RM Retail Sales' sheet."
        )

        st.markdown(
            """
### Required columns

The dashboard requires:

- `FY 26 TGT EQ NS`
- `Equity NS Ach YTD June`

Recommended:

- `Employee Name`
- `ZONE`
- `REGION`
- `EM City`
- `MKT TYPE`

### Calculation

**Current Monthly Run Rate**

`Equity NS Ach YTD June / 3`

**Projected Incremental NS**

`Current Monthly Run Rate × Projection Months`

**Projected Final NS**

`YTD June Achievement + Projected Incremental NS`
"""
        )

        return

    # --------------------------------------------------------
    # LOAD DATA
    # --------------------------------------------------------
    try:
        df = load_excel(uploaded_file)
    except Exception as e:
        st.error(
            f"Unable to read Excel file:\n\n{e}"
        )
        return

    # --------------------------------------------------------
    # FIND REQUIRED COLUMNS
    # --------------------------------------------------------
    target_column = find_column(
        df,
        TARGET_COL,
    )

    achievement_column = find_column(
        df,
        JUNE_ACH_COL,
    )

    if target_column is None:
        st.error(
            f"Required column '{TARGET_COL}' "
            "was not found."
        )

        st.write(
            "Columns found:",
            list(df.columns),
        )

        return

    if achievement_column is None:
        st.error(
            f"Required column '{JUNE_ACH_COL}' "
            "was not found."
        )

        st.write(
            "Columns found:",
            list(df.columns),
        )

        return

    # --------------------------------------------------------
    # RENAME REQUIRED COLUMNS
    # --------------------------------------------------------
    df = df.rename(
        columns={
            target_column: TARGET_COL,
            achievement_column: JUNE_ACH_COL,
        }
    )

    # --------------------------------------------------------
    # REMOVE INVALID RECORDS
    # --------------------------------------------------------
    df[TARGET_COL] = numeric_series(
        df,
        TARGET_COL,
    )

    df[JUNE_ACH_COL] = numeric_series(
        df,
        JUNE_ACH_COL,
    )

    # Keep rows where at least target or achievement exists
    df = df[
        (df[TARGET_COL] != 0)
        | (df[JUNE_ACH_COL] != 0)
    ].copy()

    # --------------------------------------------------------
    # PAGE NAVIGATION
    # --------------------------------------------------------
    page = st.sidebar.radio(
        "Dashboard Page",
        [
            "Scenario Dashboard",
            "Analytics & Visualizations",
        ],
    )

    st.sidebar.markdown("---")

    st.sidebar.write(
        f"**Sheet:** {SHEET_NAME}"
    )

    st.sidebar.write(
        f"**RMs loaded:** {len(df):,}"
    )

    # --------------------------------------------------------
    # PAGE
    # --------------------------------------------------------
    if page == "Scenario Dashboard":
        page_scenario_dashboard(df)
    else:
        page_analytics(df)


if __name__ == "__main__":
    main()
