@st.cache_data
def load_excel(file):
    excel = pd.ExcelFile(file)

    if SHEET_NAME not in excel.sheet_names:
        raise ValueError(
            f"Sheet '{SHEET_NAME}' was not found.\n\n"
            f"Available sheets:\n"
            + "\n".join(excel.sheet_names)
        )

    df = pd.read_excel(
        excel,
        sheet_name=SHEET_NAME,
    )

    return clean_dataframe(df)


# ============================================================
# CALCULATION ENGINE
# ============================================================

def calculate_scenario(df, months, uplift=0):
    result = df.copy()

    # --------------------------------------------------------
    # CURRENT ACHIEVEMENT
    # --------------------------------------------------------
    result["Current Achievement"] = numeric_series(
        result,
        JUNE_ACH_COL,
    )

    # --------------------------------------------------------
    # FY26 TARGET
    # --------------------------------------------------------
    result["FY26 Target"] = numeric_series(
        result,
        TARGET_COL,
    )

    # --------------------------------------------------------
    # CURRENT MONTHLY RUN RATE
    # --------------------------------------------------------
    result["Current Monthly Run Rate"] = (
        result["Current Achievement"] / 3
    )

    # --------------------------------------------------------
    # UPLIFTED RUN RATE
    # --------------------------------------------------------
    result["Adjusted Monthly Run Rate"] = (
        result["Current Monthly Run Rate"]
        * (1 + uplift)
    )

    # --------------------------------------------------------
    # FUTURE REVENUE
    # --------------------------------------------------------
    result["Future Incremental NS"] = (
        result["Adjusted Monthly Run Rate"]
        * months
    )

    # --------------------------------------------------------
    # PROJECTED FINAL NS
    # --------------------------------------------------------
    result["Projected Final NS"] = (
        result["Current Achievement"]
        + result["Future Incremental NS"]
    )

    # --------------------------------------------------------
    # ACHIEVEMENT %
    # --------------------------------------------------------
    result["Projected Achievement %"] = np.where(
        result["FY26 Target"] > 0,
        (
            result["Projected Final NS"]
            / result["FY26 Target"]
        ) * 100,
        0,
    )

    # --------------------------------------------------------
    # GAP TO TARGET
    # --------------------------------------------------------
    result["Gap to Target"] = (
        result["FY26 Target"]
        - result["Projected Final NS"]
    )

    # --------------------------------------------------------
    # TARGET STATUS
    # --------------------------------------------------------
    result["100% Target Achieved"] = (
        result["Projected Achievement %"] >= 100
    )

    result["120% Target Achieved"] = (
        result["Projected Achievement %"] >= 120
    )

    # --------------------------------------------------------
    # CONTRIBUTION TO TOTAL
    # --------------------------------------------------------
    total_revenue = result["Projected Final NS"].sum()

    if total_revenue > 0:
        result["Revenue Contribution %"] = (
            result["Projected Final NS"]
            / total_revenue
        ) * 100
    else:
        result["Revenue Contribution %"] = 0

    # --------------------------------------------------------
    # CURRENT JUNE ACHIEVEMENT %
    # --------------------------------------------------------
    result["Current Achievement %"] = np.where(
        result["FY26 Target"] > 0,
        (
            result["Current Achievement"]
            / result["FY26 Target"]
        ) * 100,
        0,
    )

    return result


# ============================================================
# KPI CALCULATIONS
# ============================================================

def calculate_kpis(df):
    total_target = df["FY26 Target"].sum()
    current_achievement = df["Current Achievement"].sum()
    current_run_rate = df["Current Monthly Run Rate"].sum()
    future_incremental = df["Future Incremental NS"].sum()
    projected_revenue = df["Projected Final NS"].sum()

    achievement_pct = (
        projected_revenue / total_target * 100
        if total_target > 0
        else 0
    )

    current_achievement_pct = (
        current_achievement / total_target * 100
        if total_target > 0
        else 0
    )

    rm_100_current = (
        df["Current Achievement %"] >= 100
    ).sum()

    rm_100_projected = (
        df["Projected Achievement %"] >= 100
    ).sum()

    rm_120_projected = (
        df["Projected Achievement %"] >= 120
    ).sum()

    return {
        "total_target": total_target,
        "current_achievement": current_achievement,
        "current_run_rate": current_run_rate,
        "future_incremental": future_incremental,
        "projected_revenue": projected_revenue,
        "achievement_pct": achievement_pct,
        "current_achievement_pct": current_achievement_pct,
        "rm_100_current": rm_100_current,
        "rm_100_projected": rm_100_projected,
        "rm_120_projected": rm_120_projected,
        "rm_count": len(df),
    }


# ============================================================
# CONTRIBUTION DISTRIBUTION
# ============================================================

def contribution_distribution(df):
    contribution = df["Revenue Contribution %"].copy()

    bins = [
        0,
        0.25,
        0.5,
        1,
        1.5,
        2,
        3,
        5,
        10,
        np.inf,
    ]

    labels = [
        "0–0.25%",
        "0.25–0.5%",
        "0.5–1%",
        "1–1.5%",
        "1.5–2%",
        "2–3%",
        "3–5%",
        "5–10%",
        "10%+",
    ]

    bucket = pd.cut(
        contribution,
        bins=bins,
        labels=labels,
        include_lowest=True,
    )

    distribution = (
        bucket
        .value_counts()
        .sort_index()
        .reset_index()
    )

    distribution.columns = [
        "Contribution Range",
        "RM Count",
    ]

    return distribution


# ============================================================
# BELL CURVE
# ============================================================

def create_bell_curve(df):
    values = df["Revenue Contribution %"].dropna()

    if len(values) < 2:
        return None

    mean = values.mean()
    std = values.std()

    if std == 0:
        return None

    x = np.linspace(
        max(0, mean - 4 * std),
        mean + 4 * std,
        300,
    )

    y = (
        1
        / (std * np.sqrt(2 * np.pi))
    ) * np.exp(
        -0.5 * ((x - mean) / std) ** 2
    )

    fig = go.Figure()

    fig.add_trace(
        go.Histogram(
            x=values,
            histnorm="probability density",
            nbinsx=20,
            name="RM Contribution",
        )
    )

    fig.add_trace(
        go.Scatter(
            x=x,
            y=y,
            mode="lines",
            name="Bell Curve",
        )
    )

    fig.update_layout(
        title="RM Revenue Contribution Distribution",
        xaxis_title="Contribution to Total Revenue (%)",
        yaxis_title="Density",
        template="plotly_white",
        height=450,
    )

    return fig


